<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!--
    xunit, xunit.runner.visualstudio, and Microsoft.NET.Test.Sdk come from the Arcade SDK
    (XUnit.targets and Tests.props). Referencing them here as well pins different versions, and
    NuGet fails the restore on the resulting downgrade.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\arcade-versioning-sample.csproj" />
  </ItemGroup>
</Project>