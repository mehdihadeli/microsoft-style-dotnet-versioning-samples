<Project>

  <!--
    Arcade requires its Sdk.props to be imported before any repository customization so the
    toolset defaults, eng/Versions.props, and the version targets are in place first.
  -->
  <Import Project="Sdk.props" Sdk="Microsoft.DotNet.Arcade.Sdk" />

  <PropertyGroup>
    <!--
      Eng/Versions.props owns the version inputs. Everything else on Version, PackageVersion,
      and OfficialBuild is produced by Arcade's version targets, so this file has nothing left
      to compute.
    -->
    <RepositoryRoot Condition="'$(RepositoryRoot)' == ''">$(MSBuildThisFileDirectory)</RepositoryRoot>
  </PropertyGroup>

</Project>
