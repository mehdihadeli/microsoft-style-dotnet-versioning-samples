<Project>

  <!--
    Arcade's native version inputs. The Arcade SDK locates this file through
    $(VersionsPropsPath) (see DefaultVersions.props in the SDK) and imports it before the
    version targets run, so nothing else in the repository has to reference it.

    VersionPrefix      the train that is being developed, validated against release tags
    PreReleaseVersionLabel   preview while feature work lands, rc while a candidate is hardening
    PreReleaseVersionIteration  the committed fallback iteration used by builds that do not
                                run the release adapter
  -->
  <PropertyGroup>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">1.0.0</VersionPrefix>
    <PreReleaseVersionLabel Condition="'$(PreReleaseVersionLabel)' == ''">preview</PreReleaseVersionLabel>
    <PreReleaseVersionIteration Condition="'$(PreReleaseVersionIteration)' == ''">1</PreReleaseVersionIteration>
  </PropertyGroup>

</Project>
