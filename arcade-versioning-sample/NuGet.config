<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      The Arcade SDK is resolved as an MSBuild SDK by name, so NuGet has to be able to reach
      the Microsoft engineering feed where it is published. nuget.org stays available for
      everything else.
    -->
    <add key="dotnet-eng" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-eng/nuget/v3/index.json" />
  </packageSources>
</configuration>
